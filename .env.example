# Server
PORT=3000
LLMEVAL_DB_PATH=./data/llmeval.sqlite
# Optional static bearer token protecting /mcp and /api when set
MCP_BEARER_TOKEN=

# Providers (only the ones you use are required)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Defaults (provider:model). When a default's provider has no key, llmEval falls back to the first
# usable model (installed Ollama models first) and shows the fallback in Settings / list_models.
# Local-only setup: start Ollama, `ollama pull qwen2.5:7b`, then set all three to ollama:qwen2.5:7b.
DEFAULT_MODEL=anthropic:claude-opus-5
JUDGE_MODEL=anthropic:claude-opus-5
GENERATION_MODEL=anthropic:claude-opus-5

# Execution
MAX_CONCURRENCY=4
# Per-item model call timeout in ms (default 5 minutes); Ollama runs default to concurrency 1
ITEM_TIMEOUT_MS=300000
AUTO_RESUME=true
ALLOW_UNLISTED_MODELS=false
