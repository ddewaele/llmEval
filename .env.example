# Server
PORT=3000
LLMEVAL_DB_PATH=./data/llmeval.sqlite
# Optional static bearer token protecting /mcp and /api when set
MCP_BEARER_TOKEN=

# Providers (only the ones you use are required)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Defaults (provider:model)
DEFAULT_MODEL=anthropic:claude-opus-5
JUDGE_MODEL=anthropic:claude-opus-5
GENERATION_MODEL=anthropic:claude-opus-5

# Execution
MAX_CONCURRENCY=4
AUTO_RESUME=true
ALLOW_UNLISTED_MODELS=false
